# Gamma API polling interval (ms)
GAMMA_POLL_INTERVAL=60000

# Tick sampling interval (ms)
TICK_INTERVAL=1000

# Database path
DB_PATH=./data/paint.db

# Strategy A: Latency Arb — minimum Binance momentum (fraction, e.g. 0.003 = 0.3%)
LATENCY_ARB_MOMENTUM_THRESHOLD=0.003

# Strategy A: maximum CLOB ask price to consider "stale" odds
LATENCY_ARB_MAX_ASK=0.55

# Strategy B: Spread Capture — maximum UP+DOWN ask sum
SPREAD_CAPTURE_THRESHOLD=0.98

# Momentum calculation window (ms)
MOMENTUM_WINDOW_MS=10000

# Simulated position size (notional USD)
POSITION_SIZE=100

# Max concurrent open positions
MAX_OPEN_POSITIONS=5

# Log level: debug | info | warn | error
LOG_LEVEL=info
