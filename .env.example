# Shared secrets and dashboard bootstrap
AGENT_SECRET=dev-agent-secret
JWT_SECRET=dev-jwt-secret-change-in-production
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Runtime paths and logging
DB_PATH=./data/paint.db
LOG_LEVEL=info
EXECUTION_MODE=paper
FEED_EVENT_STORAGE_PROFILE=replay_grade
LIVE_SIDECAR_URL=http://127.0.0.1:3210

# Market discovery and sampling
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
GAMMA_POLL_INTERVAL=60000
TICK_INTERVAL=1000

# Feed freshness and simulated execution
SIM_ORDER_LATENCY_MS=250
MAX_BOOK_STALENESS_MS=1000
MAX_SIGNAL_FEED_AGE_MS=1000
MAX_QUOTE_AGE_MS=750
CHAINLINK_STALE_MS=30000
WEBSOCKET_CONNECT_TIMEOUT_MS=10000
BINANCE_NO_MESSAGE_RECONNECT_MS=5000
CLOB_NO_MESSAGE_RECONNECT_MS=20000

# Runtime worker budgets
FEED_EVENT_WRITER_QUEUE_CAPACITY=50000
FEED_EVENT_WRITER_BATCH_SIZE=500
FEED_EVENT_WRITER_FLUSH_MS=100
FEED_EVENT_WRITER_MAX_LAG_MS=2000
CLOB_REPLAY_BLOCK_MAX_ROWS=10000
CLOB_REPLAY_BLOCK_MAX_MS=1000
CLOB_REPLAY_BLOCK_ZSTD_LEVEL=3
LIVE_RUNTIME_MAX_DB_BYTES=50000000000
LIVE_DECISION_QUEUE_CAPACITY=128
LIVE_DECISION_OUTPUT_QUEUE_CAPACITY=1024
LIVE_RUNTIME_PERSISTENCE_QUEUE_CAPACITY=10000
LIVE_SUBMISSION_QUEUE_CAPACITY=1024
MAX_LIVE_DECISION_AGE_MS=250
WORKER_SHUTDOWN_TIMEOUT_MS=5000

# Resolution handling
RESOLUTION_INITIAL_DELAY_MS=30000
RESOLUTION_POLL_DELAY_MS=10000

# Pending-settlement reserve policy
# The current live-readonly and first canary baseline uses the run-012 risky
# reserve profile:
# - release the strategy-family sleeve at market close
# - keep 25% of the global reserve locked until authoritative settlement
# - do not count pending-settlement trades toward the open-position cap
PENDING_SETTLEMENT_FAMILY_RESERVE_FRACTION=0.0
PENDING_SETTLEMENT_GLOBAL_RESERVE_FRACTION=0.25
PENDING_SETTLEMENT_COUNTS_AS_OPEN_POSITION=false

# Exact-run parity mode for pulled-run backtests and sweeps only.
# Leave immediate for broad historical studies.
BACKTEST_SETTLEMENT_MODE=immediate

# Common reserve modes:
# compatibility: 1.0 / 1.0 / true
# conservative:  0.0 / 1.0 / false
# risky:         0.0 / 0.25 / false

# Shared bankroll and risk controls
STARTING_BALANCE=100
MAX_POSITION_FRACTION=0.05
MAX_POSITION_USD_FRACTION=0.20
MAX_POSITION_USD=500
MIN_BALANCE_THRESHOLD=20
MAX_DRAWDOWN_PCT=0.50
MAX_OPEN_POSITIONS=5
MIN_WINDOW_TIME_MS=90000
MIN_BET_USD=5

# Live-money session caps.
# These are only used by EXECUTION_MODE=live_readonly or live_trading.
# In live_readonly they cap the real venue/account monitor and the shadow paper bankroll seed.
# The first proxy-wallet canary should stay in the 75-100 USD range.
LIVE_SESSION_CASH_CAP_USD=100
LIVE_MAX_SINGLE_ORDER_USD=10
LIVE_MAX_OPEN_NOTIONAL_USD=25
LIVE_MAX_DAILY_LOSS_USD=15
LIVE_MAX_SESSION_DRAWDOWN_USD=20
LIVE_MIN_REQUIRED_CASH_USD=25

# Kelly and drawdown controls
KELLY_FRACTION=0.5
MIN_WIN_RATE_FOR_KELLY=0.52
MIN_TRADES_FOR_KELLY=20
MIN_KELLY_FLOOR=0.03
KELLY_ROLLING_WINDOW=30
PEAK_DD_PAUSE_PCT=0.30
PEAK_DD_PAUSE_MS=3600000
DD_PAUSE_RECOVERY_PCT=0.05
CIRCUIT_BREAKER_LOSSES=3
CIRCUIT_BREAKER_PAUSE_MS=900000

# Portfolio routing and trend filtering
REGIME_DETECTION_ENABLED=true
TREND_FILTER_ENABLED=false
TREND_FILTER_PER_STRATEGY=true
TREND_FILTER_THRESHOLD=0.30
TREND_FILTER_WINDOW=10

# Fees
TAKER_FEE_RATE=0.072
TAKER_FEE_EXPONENT=1

# Run-012 latency-only live-readonly/canary strategy settings
LATENCY_ARB_ENABLED=true
LATENCY_ARB_MOMENTUM_THRESHOLD=0.0008
LATENCY_ARB_MAX_ASK=0.60
LATENCY_ARB_MIN_ASK=0.30
LATENCY_ARB_COOLDOWN_MS=60000
LATENCY_ARB_ADAPTIVE_WINDOW_MS=1800000
LATENCY_ARB_MAX_POSITION_FRACTION=0.125

SPREAD_CAPTURE_ENABLED=false
SPREAD_CAPTURE_THRESHOLD=0.970
SPREAD_CAPTURE_MIN_ASK=0.15
SPREAD_CAPTURE_MAX_LEG_SKEW_MS=25
SPREAD_CAPTURE_MAX_QUOTE_CHURN_PER_S=8
SPREAD_CAPTURE_MAX_POSITION_FRACTION=0.05

CALM_PERSISTENCE_ENABLED=false
CALM_PERSISTENCE_MIN_WINDOW_TIME_MS=30000
CALM_PERSISTENCE_MAX_WINDOW_TIME_MS=90000
CALM_PERSISTENCE_MAX_ASK=0.65
CALM_PERSISTENCE_MIN_ABS_DISTANCE_BPS=6
CALM_PERSISTENCE_DISTANCE_VOL_RATIO_THRESHOLD=1.0
CALM_PERSISTENCE_MAX_REALIZED_VOL_15S_BPS=80
CALM_PERSISTENCE_MAX_OPEN_CROSSES_30S=1
CALM_PERSISTENCE_MAX_QUOTE_CHURN_PER_S=100
CALM_PERSISTENCE_MIN_ALIGNMENT_FRACTION=0.5
CALM_PERSISTENCE_MAX_FAIR_BIAS=0.35
CALM_PERSISTENCE_MIN_EXPECTED_EDGE=0.05
CALM_PERSISTENCE_MAX_POSITION_FRACTION=0.05

# Binance stream configuration
BINANCE_REQUEST_MICROSECONDS=true
BINANCE_TRADE_STREAM=btcusdt@aggTrade
BINANCE_BOOK_TICKER_STREAM=btcusdt@bookTicker
BINANCE_DEPTH_STREAM=btcusdt@depth5@100ms

# Reconnect and throttling
# Connect attempts are bounded by WEBSOCKET_CONNECT_TIMEOUT_MS.
# Binance and CLOB also force reconnect if the socket stays open but no text
# market data arrives within their no-message watchdog windows.
RECONNECT_MIN_STABLE_MS=5000
RECONNECT_MAX_FAILURES=20
RECONNECT_PAUSE_MS=300000

# Polymarket live sidecar.
# Magic-link or email accounts use POLY_PROXY (signature type 1), require the
# exported Polymarket private key, and use the proxy wallet as the funder.
# Keep these unset in paper mode. Real venue routing remains sidecar-backed and
# live_trading remains gated in the bot until the arming/runtime phases land.
# The sidecar has real /health, /account, /preflight, /orders, /cancel,
# /cancel-all, and /redeem-all venue-boundary implementations.
SIDECAR_PORT=3210
SIDECAR_HOST=127.0.0.1
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_RELAYER_HOST=https://relayer-v2.polymarket.com
POLYMARKET_CLOCK_DRIFT_MAX_MS=1500
POLYMARKET_HTTP_TIMEOUT_MS=5000
POLYMARKET_SDK_TIMEOUT_MS=5000
POLYMARKET_REDEMPTION_POLL_INTERVAL_MS=3000
POLYMARKET_REDEMPTION_MAX_POLLS=20
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_WALLET=
# Defaults to POLYMARKET_PROXY_WALLET when left empty.
POLYMARKET_FUNDER=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
